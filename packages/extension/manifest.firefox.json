{
  "manifest_version": 3,
  "name": "lang & rund",
  "short_name": "lang & rund",
  "version": "1.8.9",
  "description": "Liest Webseiten im Lesemodus mit historischem langem ſ und rundem s.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lang-und-rund@langs.local",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "lang & rund",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [],
  "commands": {
    "open-reader": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "lang & rund öffnen"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "reader.html",
        "start.html",
        "impressum.html",
        "datenschutz.html",
        "assets/*",
        "fonts/*",
        "icons/*",
        "READABILITY-LICENSE.md"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
