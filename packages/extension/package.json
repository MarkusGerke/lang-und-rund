{
  "name": "@langs/extension",
  "version": "1.9.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/pack.mjs",
    "build": "tsc -p tsconfig.json --noEmit && node scripts/check-host-s-regeln.mjs && node scripts/build.mjs && node scripts/build-app.mjs && node scripts/pack.mjs",
    "build:app": "node scripts/check-host-s-regeln.mjs && node scripts/build-app.mjs",
    "check:s-regeln": "node scripts/check-host-s-regeln.mjs",
    "build:chrome": "pnpm build",
    "build:firefox": "pnpm build",
    "bake:watch": "node scripts/bake-watch-data.mjs"
  },
  "dependencies": {
    "@langs/core": "workspace:*",
    "@mozilla/readability": "^0.6.0"
  },
  "devDependencies": {
    "@fontsource/unifrakturcook": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.2.5",
    "@types/chrome": "^0.0.326",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.1.1"
  }
}
