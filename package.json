{
  "name": "langs-monorepo",
  "private": true,
  "version": "1.5.1",
  "description": "lang & rund – historisches langes/rundes s (Editor + Browser-Erweiterung)",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @langs/core test",
